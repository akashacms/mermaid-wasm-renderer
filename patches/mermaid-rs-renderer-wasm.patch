+/// Register in-memory font bytes (TTF/OTF) for text measurement.
+///
+/// On platforms without system font access (e.g. `wasm32-unknown-unknown`)
+/// this is the only way to provide real font metrics; without it, layout
+/// falls back to calibrated approximate widths.
+///
+/// The first registered font also becomes the target of the generic CSS
+/// families (`sans-serif`, `monospace`, ...) so that themes referencing
+/// only generic families resolve to a real face.
+pub fn register_font_data(data: Vec<u8>) {
+    let Ok(mut guard) = TEXT_MEASURER.lock() else {
+        return;
+    };
+    let first_font = guard.db.is_empty();
+    guard.db.load_font_data(data);
+    if first_font {
+        let family = guard
+            .db
+            .faces()
+            .next()
+            .and_then(|face| face.families.first().map(|(name, _)| name.clone()));
+        if let Some(family) = family {
+            guard.db.set_sans_serif_family(family.clone());
+            guard.db.set_serif_family(family.clone());
+            guard.db.set_monospace_family(family.clone());
+            guard.db.set_cursive_family(family.clone());
+            guard.db.set_fantasy_family(family);
+        }
+    }
+    guard.cache.clear();
+}
