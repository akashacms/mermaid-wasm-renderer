diff --git a/src/timing.rs b/src/timing.rs
new file mode 100644
index 0000000..63cbbca
--- /dev/null
+++ b/src/timing.rs
@@ -0,0 +1,24 @@
+//! Monotonic clock shim.
+//!
+//! `std::time::Instant::now()` panics at runtime on
+//! `wasm32-unknown-unknown` ("time not implemented on this platform").
+//! Timing metrics are diagnostic only, so on wasm they degrade to zero
+//! instead of aborting rendering.
+
+#[cfg(not(target_arch = "wasm32"))]
+pub use std::time::Instant;
+
+#[cfg(target_arch = "wasm32")]
+#[derive(Clone, Copy, Debug)]
+pub struct Instant;
+
+#[cfg(target_arch = "wasm32")]
+impl Instant {
+    pub fn now() -> Self {
+        Instant
+    }
+
+    pub fn elapsed(&self) -> std::time::Duration {
+        std::time::Duration::ZERO
+    }
+}
